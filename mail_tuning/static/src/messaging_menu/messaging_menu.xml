<templates xml:space="preserve">
    <t t-inherit="mail.MessagingMenu-navigation" t-inherit-mode="extension">
        <xpath expr="//button[hasclass('o-mail-MessagingMenu-tab')]" position="attributes">
            <attribute name="t-att-aria-label">this.tabLabel(tab)</attribute>
        </xpath>
        <xpath
            expr="//button[hasclass('o-mail-MessagingMenu-tab')]/span[hasclass('o-xsmaller')]"
            position="attributes"
        >
            <attribute name="t-out">this.tabLabel(tab)</attribute>
        </xpath>
    </t>
</templates>
